# Copy this file to .env and fill in your values
# ===== TELEGRAM BOT =====
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_GROUP_ID=your_group_id_here
VITE_TELEGRAM_THREAD_ID=your_newsletter_topic_id
VITE_TELEGRAM_THREAD_ID_CONTACT=your_contact_topic_id
VITE_TELEGRAM_THREAD_ID_ORDERS=your_orders_topic_id

# ===== FIREBASE =====
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== TELEFON + PAROL (psevdo-email domeni) =====
# Mijoz bir marta SMS bilan tasdiqdan o'tadi, keyin telefon raqam + parol
# bilan kiradi. Firebase'da bunday provayder yo'q, shuning uchun raqamdan
# "psevdo-email" yasaladi: 998901234567@<shu domen>. Bu manzilga hech
# narsa yuborilmaydi.
#
# QOIDALAR:
#   1. TASODIFIY qiymat qo'ying, taxmin qilinadigan emas:
#        printf '%s.local\n' "$(openssl rand -hex 8)"
#      Masalan: 4f9c2a71b03de85a.local
#   2. Bir marta qo'yiladi va KEYIN O'ZGARTIRILMAYDI — domen o'zgarsa
#      hamma mijozning psevdo-emaili o'zgaradi va parollari ishlamay
#      qoladi (SMS bilan kirib parolni qayta o'rnatishga to'g'ri keladi).
#   3. Bo'sh qoldirilsa telefon+parol O'CHIRILADI (faqat SMS ishlaydi) —
#      ataylab shunday: zaxira domen bilan jimgina ishga tushirish
#      keyinchalik hammani paroldan ayirardi.
#   4. Bu SIR EMAS: frontend-only ilovada u bundle ichida ko'rinadi.
#      Haqiqiy himoya — ro'yxatdan o'tish formasidagi bloklash va
#      (tavsiya) Firebase Auth blocking function. docs/XAVFSIZLIK-MIGRATSIYA.md
VITE_PHONE_AUTH_DOMAIN=
