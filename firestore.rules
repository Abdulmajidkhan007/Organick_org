rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin huquqi IKKI manbadan kelishi mumkin:
    //   1) Firebase custom claim `{ admin: true }` — faqat server
    //      (Admin SDK / Cloud Shell) o'rnata oladi, brauzerdan
    //      soxtalashtirib bo'lmaydi. TEZ yo'l: token allaqachon
    //      so'rov bilan birga kelgan, qo'shimcha o'qish yo'q.
    //   2) `admins/{uid}` hujjatining mavjudligi — CLI'siz, faqat
    //      Firebase Console orqali qo'yiladigan ZAXIRA yo'l
    //      (docs/XAVFSIZLIK-MIGRATSIYA.md, A-BO'LIM).
    //
    // TARTIB MUHIM: claim BIRINCHI turadi. Firestore `||` ni qisqa
    // tutashuv (short-circuit) qiladi, ya'ni claim bor bo'lsa
    // `exists()` UMUMAN bajarilmaydi — na qo'shimcha hujjat o'qishi,
    // na uning Blaze tarifidagi narxi bo'ladi. Ikkalasini almashtirib
    // qo'ymang: aks holda har bir admin so'rovi bitta ortiqcha
    // o'qishga aylanadi.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Hujjat egasi: buyurtmadagi userId kirgan foydalanuvchi uid'iga teng.
    // Mehmon buyurtmalarida userId == null bo'ladi va ular hech qachon
    // hech kimga "o'ziniki" bo'lmaydi — faqat admin ko'ra oladi.
    function isOwner() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Admin ro'yxati. Hujjat MAVJUDLIGIning o'zi admin degani —
    // maydonlari bo'sh bo'lsa ham bo'ladi.
    match /admins/{adminId} {
      // Har kim faqat O'ZINING hujjatini o'qiy oladi: shu bilan
      // adminlar ro'yxatini (uid'larni) chetdan sanab chiqib bo'lmaydi.
      allow read: if request.auth != null && request.auth.uid == adminId;

      // Yozish mumkin emas — na foydalanuvchi, na adminning o'zi.
      // Admin qo'shish/olib tashlash FAQAT Firebase Console orqali
      // (Console qoidalardan o'tmaydi). Bu qatorni ochib qo'ymang:
      // aks holda kim admin bo'lishini foydalanuvchi o'zi hal qiladi.
      allow write: if false;
    }

    match /orders/{orderId} {
      // Buyurtma berish: kirmagan mehmon ham bera olishi kerak.
      allow create: if true;

      // O'qish: faqat o'z buyurtmasi yoki admin.
      // Bu shart ro'yxat (list) so'rovlariga ham tegishli — shuning uchun
      // foydalanuvchi so'rovi majburan where('userId','==',uid) bilan
      // cheklangan bo'lishi shart (src/firebase/firestore.ts).
      allow read: if isOwner() || isAdmin();

      // Holatni o'zgartirish va o'chirish: FAQAT admin.
      allow update, delete: if isAdmin();
    }

    // Foydalanuvchi kabineti: profil (ism, telefon, manzillar). FAQAT egasi —
    // admin ham o'qimaydi, mijoz manzili yangi ochiq joyga chiqmasligi kerak
    // (CLAUDE.md, Maxfiylik). `orders` va `admins` qoidalariga bu tegmaydi.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // KATALOG — mahsulotlar va bloglar. Ilgari ular faqat adminning
    // localStorage'ida yashardi, ya'ni admin qo'shgan mahsulot boshqa
    // hech kimga ko'rinmasdi. Endi manba shu ikki kolleksiya.
    //
    // `read: if true` — katalog OMMAVIY: kirmagan mehmon ham do'konni
    // ko'rishi kerak. Bu yerda maxfiy ma'lumot YO'Q (mijoz telefoni
    // yoki manzili emas — faqat mahsulot nomi, narxi, rasm URL'i).
    // Mijoz buni Firestore SDK'siz, oddiy REST GET bilan o'qiydi
    // (src/firebase/catalogRest.ts) — shuning uchun o'qish auth'siz
    // ishlashi SHART.
    //
    // `write: if isAdmin()` — yozish faqat admin claim'i yoki
    // `admins/{uid}` hujjati bo'lganda (yuqoridagi `isAdmin()`).
    // DIQQAT: bu qatorni kengaytirmang. Zaxira (`stock`) va reyting
    // (`rating`/`ratingSum`/`ratingCount`) mijozdan ham yozishni talab
    // qiladi — buni bu qoida orqali ochish katalogni hammaga ochiq
    // qilardi. Shuning uchun ular `functions/src/index.ts` dagi
    // `applyOrderStock` / `rateProduct` Cloud Function'lari orqali,
    // Admin SDK bilan keladi (Admin SDK qoidalardan chetlab o'tadi).
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // `products/{id}/ratings/{uid}` — mijozning har bir mahsulotga
      // qo'ygan bahosi. BU YERDA ATAYLAB alohida `match` YO'Q: unga
      // faqat Cloud Function (`rateProduct`, Admin SDK) yozadi, Admin
      // SDK esa qoidalardan chetlab o'tadi — mijoz esa uni umuman
      // o'qimaydi/yozmaydi (o'rtacha baho `products/{id}` hujjatida,
      // `rating`/`ratingSum`/`ratingCount`). Fayl oxiridagi
      // `match /{document=**} { allow read, write: if false; }` bu
      // sub-kolleksiyani ham qamrab oladi — qoida "yozilmay qolgani"
      // emas, ATAYLAB shunday. To'liq sabab: docs/ARXITEKTURA-TARIXI.md.
    }

    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kontakt murojaatlari va newsletter obunalari. `create: if true` —
    // kirmagan mehmon ham yubora oladi (kontakt forma, footer'dagi
    // obuna). O'QISH va O'QILGAN belgisini o'zgartirish faqat admin
    // uchun — mijoz email/xabari yangi ochiq joyga chiqmasligi kerak.
    // `delete: if false` — tasodifan yo'qotilmasin (`orders`dagi kabi).
    //
    // DIQQAT — ONGLI QARZ: `create: if true` spam yozishga ochiq (hech
    // qanday rate-limit yo'q). Mijoz tomonda matn 4000 belgidan uzun
    // bo'lsa rad etiladi (`src/firebase/messages.ts` ->
    // `isMessageTextTooLong`), lekin bu faqat hajmni cheklaydi, spam
    // OQIMINI emas. Kelajakda App Check yoki Cloud Function orqali
    // yopiladi (docs/XAVFSIZLIK-MIGRATSIYA.md, H-BO'LIM).
    match /messages/{id} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Qolgan hamma narsa yopiq.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
